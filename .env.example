# Franky Bot — salin ke .env.local (lokal) atau isi di Vercel Dashboard > Settings > Environment Variables
# JANGAN pernah commit file .env yang berisi private key ke GitHub.

# Mode kertas (true = tidak ada uang asli bergerak). Biarkan true sampai kamu paham risikonya.
DRY_RUN=true

# Batas trading
MAX_BUY_USD=5
MAX_POSITIONS=5
TAKE_PROFIT_PCT=50
STOP_LOSS_PCT=25
MAX_HOLD_HOURS=24
DAILY_LOSS_LIMIT_USD=20

# Filter pair baru
MIN_LIQUIDITY_USD=10000
MIN_VOLUME_H1_USD=1000
MAX_FDV_USD=5000000
MAX_TAX_PCT=10
SLIPPAGE_BPS=300

# Chain aktif (pisah koma): solana,bsc,base,hyperliquid
ENABLED_CHAINS=solana,bsc,base,hyperliquid

# Rahasia untuk memanggil /api/scan (opsional tapi disarankan). Isi string acak, mis. franky-123-rahasia
CRON_SECRET=

# RPC (boleh kosong, pakai default publik di bawah)
SOLANA_RPC=https://api.mainnet-beta.solana.com
BSC_RPC=https://bsc-dataseed.bnbchain.org
BASE_RPC=https://mainnet.base.org
HYPEREVM_RPC=https://rpc.hyperliquid.xyz/evm

# Router DEX HyperEVM — isi bila mau live di Hyperliquid (mis. alamat router KittenSwap).
# Kosong = Hyperliquid hanya di-scan, tidak dieksekusi.
HYPEREVM_ROUTER=

# KUNCI WALLET — hanya isi bila DRY_RUN=false. Pakai wallet KHUSUS bot, dana kecil saja.
# EVM (satu key untuk BNB + Base + HyperEVM, tanpa 0x juga boleh)
EVM_PRIVATE_KEY=
# Solana (private key base58 dari Phantom/Solflare export)
SOLANA_PRIVATE_KEY=

# Login Google untuk dashboard (opsional — proteksi dashboard, lihat README)
# GOOGLE_CLIENT_ID = Client ID dari Google Cloud Console (OAuth client, tipe Web)
# ALLOWED_EMAIL = email Google kamu (hanya email ini yang boleh login)
# SESSION_SECRET = string acak panjang untuk menandatangani session
GOOGLE_CLIENT_ID=
ALLOWED_EMAIL=
SESSION_SECRET=
